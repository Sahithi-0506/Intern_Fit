{
  "name": "internfit-root",
  "version": "1.0.0",
  "private": true,
  "description": "InternFit — Internship Discovery, Fraud Risk Analysis, Resume Skill Matching & Application Tracking Platform",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "build:shared": "npm --prefix shared run build",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:shared && npm run build:server && npm run build:client",
    "test": "npm --prefix server run test && npm --prefix client run test",
    "test:server": "npm --prefix server run test",
    "test:client": "npm --prefix client run test",
    "db:migrate": "npm --prefix server run db:migrate",
    "db:seed": "npm --prefix server run db:seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
